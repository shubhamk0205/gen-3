# =====================
# Chat model (required)
# =====================
# Works with any OpenAI-compatible provider.
# - Real OpenAI:   key starts with "sk-..." and OPENAI_BASE_URL can be left blank
# - OpenRouter:    key starts with "sk-or-..." and set OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini             # for OpenAI
# OPENAI_CHAT_MODEL=openai/gpt-4o-mini      # for OpenRouter

# =====================
# Embedding model (required) — pick ONE
# =====================
# Option A — OpenAI directly (uses OPENAI_API_KEY above; only works with a real OpenAI key)
#            Default model: text-embedding-3-small, ~$0.02 / 1M tokens
#
# Option B — Jina AI (free 10M tokens, no payment needed)
#            Sign up at https://jina.ai/embeddings, then set:
# JINA_API_KEY=jina_...

# =====================
# Vector database (required)
# =====================
# Qdrant Cloud (recommended) — free tier at https://cloud.qdrant.io
QDRANT_URL=https://your-cluster.eu-west-2-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-cloud-api-key

# Or local Docker:
# QDRANT_URL=http://localhost:6333
